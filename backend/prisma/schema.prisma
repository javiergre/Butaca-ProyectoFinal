// TODO: ajustar el modelo (índices, tipos) según las consultas del tablero
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model MoodEntry {
  id         String   @id @default(uuid())
  userId     String   // id del usuario en Supabase Auth
  emotion    String
  confidence Float?
  createdAt  DateTime @default(now())
}

model Favorite {
  id         String @id @default(uuid())
  userId     String
  tmdbId     Int
  mediaType  String // 'movie' | 'tv'
  title      String
  posterPath String?

  @@unique([userId, mediaType, tmdbId])
}
