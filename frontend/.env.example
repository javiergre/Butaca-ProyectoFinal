# Copia este archivo a .env (NO lo subas a git).
# Solo van valores PÚBLICOS: la anon key de Supabase está pensada para el navegador.
# La API key de TMDB NO va aquí: vive únicamente en el backend.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Vacío en desarrollo (Vite hace proxy a http://localhost:3000).
# En producción: URL del backend desplegado, p. ej. https://butaca-api.onrender.com
VITE_API_URL=
